# ───────────────────────────────────────────────────────────────────
# AI-First SDLC Platform — local environment template
# Copy to `.env` and adjust. NEVER commit the real .env (see .gitignore).
# ───────────────────────────────────────────────────────────────────

# ─── Django ─────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings

# ─── Application Postgres (app data; RLS-enforced) ──────────────────
# NOTE (non-negotiable #6): the app connects as a NON-superuser role so
# RLS policies actually apply. Superuser creds are for migrations/admin only.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sdlc_platform
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_APP_USER=sdlc_app
POSTGRES_APP_PASSWORD=sdlc_app_pw
# Full DSN the Django app uses inside Docker (the non-superuser role):
DATABASE_URL=postgres://sdlc_app:sdlc_app_pw@postgres:5432/sdlc_platform
# LOCAL venv tooling that touches the DB (e.g. pytest) reaches the container on
# host port 5433 (remapped to dodge a native Postgres on 5432). Override per-shell:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5433/sdlc_platform
# Most DB work runs in-container anyway (make migrate / make test).

# ─── Temporal (durable execution — non-negotiable #8) ───────────────
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sdlc-planning

# ─── CORS (React Experience plane → API; P0-T12) ────────────────────
# Comma-separated origins allowed to call /api/. Default is the Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Atlassian (Phase 1 SoR — Confluence + Jira) ────────────────────
# Headless API-token auth for control-plane writes. Create a token at
# https://id.atlassian.com/manage-profile/security/api-tokens and use a TEST
# space/project. Real values live in .env only (never commit). See docs/PHASE_1_BUILD_SPEC.md §1.
ATLASSIAN_SITE_URL=https://your-site.atlassian.net
ATLASSIAN_CLOUD_ID=
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=
CONFLUENCE_SPACE_KEY=SDLC
JIRA_PROJECT_KEY=ST

# ─── Figma (Phase 3 DesignSource — read-as-SoR) ─────────────────────
# Headless per-tenant read via a Figma personal-access token (X-Figma-Token). Use a TEST
# file. Real values live in .env only (never commit). Canvas write (PG22) is a deferred
# seam — no write creds needed in v1. See docs/PHASE_3_BUILD_SPEC.md §1.
FIGMA_API_URL=https://api.figma.com
FIGMA_TOKEN=
FIGMA_FILE_KEY=

# ─── Xray (Phase 3 TestMgmt — tests + result import) ────────────────
# Headless per-tenant auth: a Xray Cloud API key (client id + secret). Use a TEST project.
# Real values live in .env only (never commit). See docs/PHASE_3_BUILD_SPEC.md §2.
XRAY_API_URL=https://xray.cloud.getxray.app
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_PROJECT_KEY=

# ─── Knowledge Index embeddings (Phase 4 — optional; retrieval works with NO keys) ──
# The BM25 baseline needs nothing. To test semantic retrieval set EMBEDDING_PROVIDER and one
# key. NOTE: EMBEDDING_DIM is baked into the DB column at migration time — 1536 fits Gemini;
# for Voyage set EMBEDDING_DIM=1024 and re-run migrations. Confirm free-tier terms on each
# provider's pricing page. See docs/PHASE_4_BUILD_SPEC.md §2.
EMBEDDING_PROVIDER=null            # null | voyage | gemini
EMBEDDING_DIM=1536                 # 1536 = Gemini (gemini-embedding-001); 1024 = Voyage (voyage-code-3)
VOYAGE_API_URL=https://api.voyageai.com
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-3
GEMINI_API_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-embedding-001

# ─── Object store (artifact drafts + snapshots — bodies, not state) ──
# Provider-agnostic via the S3 API (boto3). Same code path for both:
#   • LOCAL dev  → MinIO: set S3_ENDPOINT_URL to the MinIO server (below).
#   • PROD/cloud → AWS S3: leave S3_ENDPOINT_URL EMPTY and prefer an IAM
#     role / instance profile over static keys. (Decision: docs/decisions/0001.)
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sdlc-artifacts

# ─── Engine (Claude Agent SDK via ClaudeDriver — non-negotiable #7) ─
ANTHROPIC_API_KEY=sk-ant-replace-me
DEFAULT_ENGINE=claude
DEFAULT_PLANNING_MODEL=claude-opus-4-8
# Optional: the Claude Code CLI path when it is installed in a non-standard location.
# Install with: npm install -g @anthropic-ai/claude-code
CLAUDE_CLI_PATH=/usr/local/bin/claude

# ─── Platform-State MCP server ──────────────────────────────────────
MCP_PLATFORM_STATE_TRANSPORT=stdio

# GitHub Creds (CodeHost capability — open/merge PRs, commit status). Put real values in .env.
GITHUB_TOKEN=ghp_your_github_pat_with_repo_scope
GITHUB_REPO=owner/repo

# ─── Email (invites + password reset) — SendGrid ────────────────────
# Leave SENDGRID_API_KEY empty to keep printing invite links in the server terminal.
# The key needs only the "Mail Send" permission; DEFAULT_FROM_EMAIL must be a sender
# verified in SendGrid (Single Sender or domain).
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=
