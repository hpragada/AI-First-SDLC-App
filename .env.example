# ───────────────────────────────────────────────────────────────────
# AI-First SDLC Platform — local environment template
# Copy to `.env` and adjust. NEVER commit the real .env (see .gitignore).
# ───────────────────────────────────────────────────────────────────

# ─── Django ─────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings

# ─── Application Postgres (app data; RLS-enforced) ──────────────────
# NOTE (non-negotiable #6): the app connects as a NON-superuser role so
# RLS policies actually apply. Superuser creds are for migrations/admin only.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sdlc_platform
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_APP_USER=sdlc_app
POSTGRES_APP_PASSWORD=sdlc_app_pw
# Full DSN the Django app uses inside Docker (the non-superuser role):
DATABASE_URL=postgres://sdlc_app:sdlc_app_pw@postgres:5432/sdlc_platform
# LOCAL venv tooling that touches the DB (e.g. pytest) reaches the container on
# host port 5433 (remapped to dodge a native Postgres on 5432). Override per-shell:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5433/sdlc_platform
# Most DB work runs in-container anyway (make migrate / make test).

# ─── Temporal (durable execution — non-negotiable #8) ───────────────
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sdlc-planning

# ─── Object store (artifact drafts + snapshots — bodies, not state) ──
# Provider-agnostic via the S3 API (boto3). Same code path for both:
#   • LOCAL dev  → MinIO: set S3_ENDPOINT_URL to the MinIO server (below).
#   • PROD/cloud → AWS S3: leave S3_ENDPOINT_URL EMPTY and prefer an IAM
#     role / instance profile over static keys. (Decision: docs/decisions/0001.)
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sdlc-artifacts

# ─── Engine (Claude Agent SDK via ClaudeDriver — non-negotiable #7) ─
ANTHROPIC_API_KEY=sk-ant-replace-me
DEFAULT_ENGINE=claude
DEFAULT_PLANNING_MODEL=claude-opus-4-8

# ─── Platform-State MCP server ──────────────────────────────────────
MCP_PLATFORM_STATE_TRANSPORT=stdio
