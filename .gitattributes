# Normalize line endings (migration spec flags v6 "mixed line endings").
# Default: treat as text, check out LF — containers (Makefile, Dockerfiles,
# shell, Python) require LF.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.ico binary
