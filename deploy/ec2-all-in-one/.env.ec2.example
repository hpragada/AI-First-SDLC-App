# ───────────────────────────────────────────────────────────────────────────
# .env.ec2.example — env for the ALL-IN-ONE EC2 box (testing / staging).
#
# Copy to the REPO ROOT as `AI-First-SDLC-App/.env` ON THE EC2 BOX. That is the
# only file Django and Compose read (settings loads BASE_DIR.parent/.env);
# `backend/.env` is a leftover that nothing loads. Never commit the filled file.
#
# Replace EVERY <...> placeholder. The one that catches people out is
# PUBLIC_ORIGIN / VITE_API_BASE — see the comment there.
# ───────────────────────────────────────────────────────────────────────────

# ─── The box's public address ───────────────────────────────────────
# Use an ELASTIC IP or a DNS name. A default EC2 public IP changes on stop/start,
# and this value is COMPILED INTO the frontend bundle — if it changes you must
# rebuild the frontend, not just restart it.
#   e.g. http://13.235.10.20    or    http://sdlc-staging.example.com
# (no trailing slash)

# ─── Django ─────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=<generate-a-strong-secret>
# false is the right default even for staging: DEBUG=true renders full tracebacks,
# env values and SQL to anyone who reaches the box. Flip to true only while
# actively debugging — and note the admin renders unstyled with it off (README).
DJANGO_DEBUG=false
# MUST list the host users type in the browser, or every request 400s.
# The bare IP/hostname only — no scheme, no port.
DJANGO_ALLOWED_HOSTS=<ec2-public-ip-or-hostname>,localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings

# ─── Application Postgres (container on this box) ───────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sdlc_platform
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=<strong-superuser-password>
POSTGRES_APP_USER=sdlc_app
POSTGRES_APP_PASSWORD=<strong-app-role-password>
# Runtime DSN — the NON-superuser role, so RLS applies to every query.
DATABASE_URL=postgres://sdlc_app:<strong-app-role-password>@postgres:5432/sdlc_platform

# ─── Temporal (container on this box) ───────────────────────────────
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sdlc-planning

# ─── CORS / CSRF ────────────────────────────────────────────────────
# nginx serves the SPA and proxies /api on the SAME origin, so cross-origin CORS
# is not used in normal operation. CSRF_TRUSTED_ORIGINS still needs the origin
# (scheme INCLUDED) for Django's referer check on unsafe methods under DEBUG=false.
CORS_ALLOWED_ORIGINS=<public-origin>
CSRF_TRUSTED_ORIGINS=<public-origin>

# ─── Object store — REAL AWS S3 (no MinIO in this deployment) ───────
# S3_ENDPOINT_URL MUST STAY EMPTY. Empty => boto3 talks to AWS S3 directly
# (backend/storage/object_store.py); any value here would redirect it to a
# self-hosted MinIO, which this deployment does not run.
S3_ENDPOINT_URL=
S3_REGION=<your-aws-region>            # e.g. ap-south-1 — must be the BUCKET's region
S3_BUCKET=<dedicated-bucket-name>      # e.g. sdlc-artifacts-staging (NOT another app's bucket)

# Credentials — pick ONE:
#   (a) PREFERRED: attach an IAM instance role to the EC2 box and leave BOTH keys
#       BLANK. Empty keys make boto3 fall back to its default credential chain,
#       which finds the role automatically. Nothing secret is then stored on disk.
#       Requires the instance metadata hop limit to be 2 — see README §4.3.
#   (b) An IAM user's access key, scoped to just this bucket.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Frontend build-time config ─────────────────────────────────────
# Inlined into the bundle by `npm run build`, and ALSO the source of the
# `companion serve --api-url ...` command printed on the Connect Machine screen
# (frontend/src/features/identity/ConnectMachine.tsx strips the trailing /api).
# Leave it unset and every user is handed a command pointing at THEIR OWN laptop.
# Must end in /api :   http://<ec2-public-ip-or-hostname>/api
VITE_API_BASE=<public-origin>/api

# ─── Engine (Claude Agent SDK) ──────────────────────────────────────
# Used ONLY for server-side runs — i.e. a user with no companion enrolled, where
# orchestration/trigger.py resolves execution_mode="server". Companion runs use
# the developer's own logged-in Claude Code subscription and never touch this key.
ANTHROPIC_API_KEY=<sk-ant-...>
DEFAULT_ENGINE=claude
DEFAULT_PLANNING_MODEL=claude-opus-4-8
CLAUDE_CLI_PATH=/usr/local/bin/claude

# ─── Platform-State MCP server ──────────────────────────────────────
# stdio = server-side runs launch it as a subprocess. Companion runs are served
# the same tools remotely over /api/runner/state/ — this setting doesn't affect them.
MCP_PLATFORM_STATE_TRANSPORT=stdio

# ─── CodeHost (GitHub) ──────────────────────────────────────────────
# The token needs write access to EVERY repo any mapped companion builds against.
GITHUB_TOKEN=<ghp_...>
GITHUB_REPO=<owner/repo>

# ─── External systems-of-record & embeddings ────────────────────────
# Copy these blocks verbatim from ../../.env.example and fill per your test tenants
# (Atlassian / Figma / Xray / Voyage / Gemini). Omitted here to keep this file
# focused on what the EC2 topology actually changes.
EMBEDDING_PROVIDER=null
EMBEDDING_DIM=1536
