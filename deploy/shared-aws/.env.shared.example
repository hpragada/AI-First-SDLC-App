# ───────────────────────────────────────────────────────────────────────────
# .env.shared.example — per-developer env for the SHARED AWS environment.
#
# Copy to `AI-First-SDLC-App/.env` (and mirror to `AI-First-SDLC-App/backend/.env`)
# on EACH developer's machine. Fill the <...> placeholders with the real shared
# values (get them from whoever ran the bootstrap). NEVER commit the filled file.
#
# Only the DB / S3 / Temporal endpoints differ from local dev — everything points
# at AWS instead of local Docker containers, so both devs share one live state.
# ───────────────────────────────────────────────────────────────────────────

# ─── Django ─────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=<generate-a-strong-secret>
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings

# ─── Application Postgres — the SHARED EC2 instance, isolated DB ─────
# Runtime connects as the non-superuser app role (RLS applies). The migration role
# (sdlc_migrator) is NOT put here — it's passed only when running `make migrate`
# (see the runbook), so day-to-day the app can never do DDL.
POSTGRES_HOST=<pg-host>            # EC2 private IP / Tailscale IP / hostname
POSTGRES_PORT=5432
POSTGRES_DB=sdlc_platform
POSTGRES_APP_USER=sdlc_app
POSTGRES_APP_PASSWORD=<app-role-password>
# The DSN the app + worker use at runtime (the non-superuser role):
DATABASE_URL=postgres://sdlc_app:<app-role-password>@<pg-host>:5432/sdlc_platform

# ─── Temporal ───────────────────────────────────────────────────────
# T1 (self-hosted on EC2): the EC2 PUBLIC IP :7233 (AWS NAT forwards to the private IP
#   where Temporal binds). Open 7233 in the security group to your IP.
# T2 (Temporal Cloud): use the Cloud gRPC endpoint + namespace, and add mTLS certs.
TEMPORAL_HOST=<ec2-public-ip>:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sdlc-planning

# ─── CORS (React dev server → API) ──────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Object store — REAL AWS S3 (no MinIO) ──────────────────────────
# Leaving S3_ENDPOINT_URL EMPTY makes boto3 talk to AWS S3 directly (ADR-0001).
S3_ENDPOINT_URL=
S3_REGION=<your-aws-region>            # e.g. ap-south-1
S3_BUCKET=<dedicated-bucket-name>      # e.g. sdlc-artifacts-shared (NOT another app's bucket)
S3_ACCESS_KEY=<iam-access-key>         # scoped to the bucket; or leave blank to use an instance role
S3_SECRET_KEY=<iam-secret-key>

# ─── Engine (Claude Agent SDK) ──────────────────────────────────────
ANTHROPIC_API_KEY=<sk-ant-...>
DEFAULT_ENGINE=claude
DEFAULT_PLANNING_MODEL=claude-opus-4-8
CLAUDE_CLI_PATH=/usr/local/bin/claude

# ─── Platform-State MCP server ──────────────────────────────────────
MCP_PLATFORM_STATE_TRANSPORT=stdio

# ─── External systems-of-record & embeddings ────────────────────────
# Copy these blocks verbatim from .env.example and fill per your test tenants
# (Atlassian / Figma / Xray / Voyage / Gemini). Left out here to keep this file
# focused on the shared-infra changes.
EMBEDDING_PROVIDER=null
EMBEDDING_DIM=1536
